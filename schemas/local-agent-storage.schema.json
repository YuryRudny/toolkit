{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local non-publishing agent storage",
  "type": "object",
  "required": ["schemaVersion", "mode", "id", "publication", "toolkit", "repositories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "local" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "publication": { "const": "never" },
    "toolkit": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1, "description": "Explicit absolute path outside customer and storage roots" } }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "role": { "const": "customer-code" },
          "path": { "type": "string", "minLength": 1, "description": "Explicit absolute path to the customer Git root" }
        }
      }
    }
  },
  "not": { "anyOf": [{ "required": ["remote"] }, { "required": ["artifactRepository"] }] }
}
