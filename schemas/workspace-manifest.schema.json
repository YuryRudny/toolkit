{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.reusable-agent-system-toolkit/workspace-manifest.schema.json",
  "title": "Sidecar Workspace Manifest",
  "type": "object",
  "required": ["schemaVersion", "workspaceId", "artifactRepository", "repositories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspaceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "artifactRepository": {
      "type": "object",
      "required": ["id", "remote"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "remote": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 }
      }
    },
    "toolkit": {
      "type": "object",
      "required": ["path", "remote"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 }
      }
    },
    "localIntegration": {
      "type": "object",
      "properties": {
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "agentsFile": { "type": "string", "minLength": 1 },
        "skillsDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "mcpServerName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "localConfig": { "type": "string", "minLength": 1 },
        "requiredServices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["jira", "confluence", "gitlab", "figma"] }
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "path", "remote"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "role": { "const": "customer-code" },
          "path": { "type": "string", "minLength": 1 },
          "remote": { "type": "string", "minLength": 1 },
          "defaultBranch": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
